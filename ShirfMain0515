# 兼容 & 全局参数
# ============================================================
if hasattr(np, 'trapezoid'):
    trapz = np.trapezoid
else:
    trapz = np.trapz

torch.manual_seed(42)
np.random.seed(42)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False

OUTPUT_DIR = "figures_science_final"
os.makedirs(OUTPUT_DIR, exist_ok=True)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")

N = 1000.0
beta_base = 0.50
delta_base = 0.40
gamma_base = 0.05
alpha_base = 0.10
eta_F = 0.2
kappa_F = 2.0
eta_H = 0.05

a, b, c = 3.0, 0.05, 0.2
theta = 9.0
epsilon = 0.1
T2_end = 30.0
T1_peak = 13.2

def compute_weight(t_val):
    if t_val <= T1_peak:
        return 1.0 + theta * t_val / T1_peak
    elif t_val <= T2_end:
        return 1.0 + theta
    else:
        return 1.0 + theta * np.exp(-epsilon * (t_val - T2_end))

T = 60.0
dt = 0.2
steps = int(T / dt)
t_arr = np.arange(0, T, dt)
S0, H0, I0, R0, F0 = 850.0, 100.0, 50.0, 0.0, 0.0

PMP_SEGMENTS = 30
PMP_MAX_ITER = 200

# ============================================================
# 动力学模型（论文原版）
# ============================================================
def compute_derivatives(state, u, t_step):
    S, H, I, R, F = state
    beta = beta_base * np.exp(-t_step * dt / 60.0)
    eff_alpha = alpha_base * (1.0 + u) * np.exp(-F)
    dS = -beta * S * I / N - 0.2 * eff_alpha * S
    dH = beta * S * I / N - delta_base * H - eta_H * H - 0.3 * eff_alpha * H
    dI = delta_base * H - gamma_base * I - 0.5 * eff_alpha * I
    dR = gamma_base * I + eta_H * H + eff_alpha * (0.2 * S + 0.3 * H + 0.5 * I)
    dF = eta_F * u - kappa_F * F
    return np.array([dS, dH, dI, dR, dF], dtype=np.float64)

def rk4_integrate(state, u, t_step, dt_val=dt):
    k1 = compute_derivatives(state, u, t_step)
    k2 = compute_derivatives(state + 0.5 * dt_val * k1, u, t_step)
    k3 = compute_derivatives(state + 0.5 * dt_val * k2, u, t_step)
    k4 = compute_derivatives(state + dt_val * k3, u, t_step)
    return state + dt_val / 6.0 * (k1 + 2.0 * k2 + 2.0 * k3 + k4)

def simulate_numpy(u_values):
    state = np.array([S0, H0, I0, R0, F0], dtype=np.float64)
    traj = np.empty((steps, 5), dtype=np.float64)
    cost_I = 0.0
    cost_u = 0.0
    cost_F = 0.0

    for t_step in range(steps):
        u = float(np.clip(u_values[t_step], 0.0, 1.0))
        traj[t_step] = state.copy()
        current_t = t_step * dt
        w = compute_weight(current_t)
        cost_I += a * state[2] * w * dt
        cost_u += b * u ** 2 * dt
        cost_F += c * state[4] ** 2 * dt
        state = rk4_integrate(state, u, t_step)
        state = np.clip(state, 0.0, None)
        mass = state[:4].sum()
        if mass > 1e-6:
            state[:4] = state[:4] * N / mass
    total_cost = cost_I + cost_u + cost_F
    return traj, cost_I, cost_u, cost_F, total_cost

# ============================================================
# PyTorch 动力学（已修复 CUDA 错误）
# ============================================================
def step_dynamics_torch(state, u, t_step):
    S, H, I, R, F = state
    beta = beta_base * torch.exp(torch.tensor(-t_step * dt / 60.0, device=device, dtype=torch.float32))
    eff_alpha = alpha_base * (1.0 + u) * torch.exp(-F)
    dS = -beta * S * I / N - 0.2 * eff_alpha * S
    dH = beta * S * I / N - delta_base * H - eta_H * H - 0.3 * eff_alpha * H
    dI = delta_base * H - gamma_base * I - 0.5 * eff_alpha * I
    dR = gamma_base * I + eta_H * H + eff_alpha * (0.2 * S + 0.3 * H + 0.5 * I)
    dF = eta_F * u - kappa_F * F
    return torch.stack([dS, dH, dI, dR, dF])

def simulate_torch_train(policy):
    state = torch.tensor([S0, H0, I0, R0, F0], device=device, dtype=torch.float32)
    cost_I = torch.tensor(0.0, device=device)
    cost_u = torch.tensor(0.0, device=device)
    cost_F = torch.tensor(0.0, device=device)
    for t_step in range(steps):
        u = policy(state.unsqueeze(0)).squeeze()
        current_t = t_step * dt
        w = compute_weight(current_t)
        w_t = torch.tensor(w, device=device, dtype=torch.float32)
        cost_I += a * state[2] * w_t * dt
        cost_u += b * u ** 2 * dt
        cost_F += c * state[4] ** 2 * dt
        k1 = step_dynamics_torch(state, u, t_step)
        k2 = step_dynamics_torch(state + 0.5 * dt * k1, u, t_step)
        k3 = step_dynamics_torch(state + 0.5 * dt * k2, u, t_step)
        k4 = step_dynamics_torch(state + dt * k3, u, t_step)
        state = state + dt / 6.0 * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
        state = torch.clamp(state, min=0.0)
        mass = state[:4].sum()
        if mass.item() > 1e-6:
            state[:4] = state[:4] * N / mass
    cost_tensor = cost_I + cost_u + cost_F
    return cost_tensor, cost_tensor.detach().cpu().item()

# ============================================================
# 控制网络
# ============================================================
def get_neural_control_sequence(policy):
    u_values = np.zeros(steps)
    state_np = np.array([S0, H0, I0, R0, F0], dtype=np.float64)
    with torch.no_grad():
        for t_step in range(steps):
            state_t = torch.tensor(state_np, dtype=torch.float32, device=device).unsqueeze(0)
            u_t = policy(state_t).cpu().item()
            u_values[t_step] = np.clip(u_t, 0.0, 1.0)
            state_np = rk4_integrate(state_np, u_values[t_step], t_step)
            state_np = np.clip(state_np, 0.0, None)
            mass = state_np[:4].sum()
            if mass > 1e-6:
                state_np[:4] = state_np[:4] * N / mass
    return u_values

class StablePeakPolicy(nn.Module):
    def __init__(self, w_peak=0.7, w_normal=0.3):
        super().__init__()
        self.w_peak = w_peak
        self.w_normal = w_normal
        self.peak_branch = nn.Sequential(
            nn.Linear(5, 64), nn.ReLU(),
            nn.Linear(64, 32), nn.ReLU(),
            nn.Linear(32, 1)
        )
        self.normal_branch = nn.Sequential(
            nn.Linear(5, 64), nn.ReLU(),
            nn.Linear(64, 32), nn.ReLU(),
            nn.Linear(32, 1)
        )
        self.fusion = nn.Sigmoid()

    def forward(self, x):
        return self.fusion(self.w_peak * self.peak_branch(x) + self.w_normal * self.normal_branch(x))

# ============================================================
# 训练
# ============================================================
def train_controller():
    policy = StablePeakPolicy(w_peak=0.7, w_normal=0.3).to(device)
    optimizer = torch.optim.Adam(policy.parameters(), lr=1.5e-3, weight_decay=1e-5)
    scheduler = lr_scheduler.CosineAnnealingLR(optimizer, T_max=500, eta_min=1e-4)
    print("\n" + "="*60)
    print("Training Neural Controller")
    print("="*60)
    best_J = float('inf')
    patience = 100
    counter = 0
    epochs = 500
    for ep in trange(epochs, desc="Training"):
        optimizer.zero_grad()
        cost_tensor, J_scalar = simulate_torch_train(policy)
        cost_tensor.backward()
        torch.nn.utils.clip_grad_norm_(policy.parameters(), max_norm=1.0)
        optimizer.step()
        scheduler.step()
        if (best_J - J_scalar) > 1e-4:
            best_J = J_scalar
            counter = 0
            torch.save(policy.state_dict(), os.path.join(OUTPUT_DIR, "best_policy.pth"))
        else:
            counter += 1
            if counter >= patience:
                print(f"\nEarly stop at epoch {ep}, Best J = {best_J:.2f}")
                break
    policy.load_state_dict(torch.load(os.path.join(OUTPUT_DIR, "best_policy.pth"), map_location=device, weights_only=True))
    policy.eval()
    print(f"Training complete. Best cost = {best_J:.2f}")
    return policy

# ============================================================
# PMP 最优控制
# ============================================================
def run_pmp_optimization():
    print("\n" + "="*60)
    print("PMP Baseline Optimization")
    print("="*60)
    def pmp_obj(u_seg):
        u_full = np.interp(np.arange(steps), np.linspace(0, steps-1, PMP_SEGMENTS), u_seg)
        u_full = np.clip(u_full, 0.0, 1.0)
        _, _, _, _, cost = simulate_numpy(u_full)
        return cost
    u0 = np.zeros(PMP_SEGMENTS)
    bounds = [(0.0,1.0)]*PMP_SEGMENTS
    res = minimize(pmp_obj, u0, method='L-BFGS-B', bounds=bounds, options={'maxiter':PMP_MAX_ITER, 'ftol':1e-6})
    print(f"PMP success: {res.success}, cost: {res.fun:.2f}, iterations: {res.nit}")
    u_pmp = np.clip(np.interp(np.arange(steps), np.linspace(0,steps-1,PMP_SEGMENTS), res.x), 0.0,1.0)
    return u_pmp, res

# ============================================================
# 鲁棒性实验（已加入：单峰性 + 稳定性检测）
# ============================================================
def run_robustness_experiments(policy_net):
    global beta_base, delta_base, gamma_base, alpha_base
    orig = {'beta':beta_base,'delta':delta_base,'gamma':gamma_base,'alpha':alpha_base}
    perturbs = {
        'Baseline':      (0.00, 0.00, 0.00, 0.00),
        r'$\beta$+10%':  (0.10, 0.00, 0.00, 0.00),
        r'$\beta$-10%': (-0.10, 0.00, 0.00, 0.00),
        r'$\delta$+10%': (0.00, 0.10, 0.00, 0.00),
        r'$\delta$-10%': (0.00,-0.10, 0.00, 0.00),
        r'$\gamma$+10%': (0.00, 0.00, 0.10, 0.00),
        r'$\gamma$-10%': (0.00, 0.00,-0.10, 0.00),
        r'$\alpha$+10%': (0.00, 0.00, 0.00, 0.10),
        r'$\alpha$-10%': (0.00, 0.00, 0.00,-0.10),
    }
    rob_results = {}
    try:
        for lab, (db,dd,dg,da) in perturbs.items():
            beta_base  = orig['beta']*(1+db)
            delta_base = orig['delta']*(1+dd)
            gamma_base = orig['gamma']*(1+dg)
            alpha_base = orig['alpha']*(1+da)
            u_rob = get_neural_control_sequence(policy_net)
            traj_rob,_,_,_,J_rob = simulate_numpy(u_rob)
            I = traj_rob[:,2]
            
            # 单峰性检测：峰值后是否存在第二个局部极大值
            peak_idx = int(np.argmax(I))
            post_peak = I[peak_idx:]
            sec_peaks, _ = find_peaks(post_peak, height=0.01*I.max(), distance=5)
            is_unimodal = (len(sec_peaks) <= 1)  # 仅全局最大峰
            
            # 动态稳定性：末端10天均值 < 峰值的5%（视为清除/收敛）
            late_mean = I[-50:].mean()  # 最后10天 (dt=0.2 → 50步)
            is_stable = late_mean < 0.05 * I.max()
            
            rob_results[lab] = {
                'traj': traj_rob, 'J': J_rob, 'Imax': I.max(),
                'unimodal': is_unimodal, 'stable': is_stable
            }
    finally:
        beta_base = orig['beta']
        delta_base = orig['delta']
        gamma_base = orig['gamma']
        alpha_base = orig['alpha']
    return rob_results

